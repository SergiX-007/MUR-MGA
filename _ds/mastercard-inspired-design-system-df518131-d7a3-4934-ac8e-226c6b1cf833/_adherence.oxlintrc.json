{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/content/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sofia Sans))/i]",
        "message": "Font not provided by the design system. Available: Sofia Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|consent|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'consent' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|shape|chip|title|ctaLabel|onCta|width|height|style|key|ref|className|style|children)$/]",
        "message": "<CarouselCard> doesn't accept that prop. Declared props: image, shape, chip, title, ctaLabel, onCta, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselCard'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:stadium|pill)$/]",
        "message": "<CarouselCard> shape must be one of 'stadium' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, variant, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|ink|outline)$/]",
        "message": "<Chip> variant must be one of 'light' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dotColor|color|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, dotColor, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:head|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: head, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|style|key|ref|className|style|children)$/]",
        "message": "<GhostHeadline> doesn't accept that prop. Declared props: children, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|as|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|ghost|on-media)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'solid' | 'ghost' | 'on-media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|activeIndex|onSearch|style|key|ref|className|style|children)$/]",
        "message": "<NavPill> doesn't accept that prop. Declared props: brand, links, activeIndex, onSearch, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortraitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|diameter|eyebrow|title|satelliteIcon|onOpen|align|style|key|ref|className|style|children)$/]",
        "message": "<PortraitCard> doesn't accept that prop. Declared props: image, diameter, eyebrow, title, satelliteIcon, onOpen, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortraitCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PortraitCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SatelliteButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|icon|as|key|ref|className|style|children)$/]",
        "message": "<SatelliteButton> doesn't accept that prop. Declared props: size, icon, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, color, size, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
